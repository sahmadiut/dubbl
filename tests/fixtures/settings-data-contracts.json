{
  "requests": {
    "app/(dashboard)/settings/import-export/page.tsx": [
      "fetch(\"/api/v1/bulk/import-jobs?\" + new URLSearchParams({ limit: \"20\" }), { headers: { \"x-organization-id\": orgId }, })",
      "params.set(\"startDate\", exportDateFrom)",
      "params.set(\"endDate\", exportDateTo)",
      "fetch(`/api/v1/export/all?${params}`, { headers: { \"x-organization-id\": orgId }, })",
      "downloadBlob(blob, \"dubbl-export.zip\")",
      "params.set(\"startDate\", exportDateFrom)",
      "params.set(\"endDate\", exportDateTo)",
      "fetch(`/api/v1/export/${key}?${params}`, { headers: { \"x-organization-id\": orgId }, })",
      "downloadBlob(blob, `${key}.csv`)",
      "a.download = filename"
    ],
    "app/(dashboard)/settings/backups/page.tsx": [
      "fetch(`/api/v1/backups?page=${p}&limit=${limit}`, { headers: { \"x-organization-id\": orgId }, })",
      "fetch(\"/api/v1/backups\", { method: \"POST\", headers: { \"x-organization-id\": orgId }, })",
      "fetch(\"/api/v1/backups/download-snapshot\", { headers: { \"x-organization-id\": orgId }, })",
      "a.download = `dubbl-snapshot-${new Date().toISOString().slice(0, 10)}.json`",
      "form.append(\"file\", file)",
      "fetch(\"/api/v1/backups/upload\", { method: \"POST\", headers: { \"x-organization-id\": orgId }, body: form, })",
      "fetch(`/api/v1/backups/${backup.id}/download`, { headers: { \"x-organization-id\": orgId }, })",
      "a.download = `backup-${new Date(backup.createdAt).toISOString().slice(0, 10)}.json`",
      "fetch(`/api/v1/backups/${restoreBackup.id}/restore`, { method: \"POST\", headers: { \"x-organization-id\": orgId, \"Content-Type\": \"application/json\", }, body: JSON.stringify({ confirm: true }), })",
      "JSON.stringify({ confirm: true })",
      "fetch(`/api/v1/backups/${deleteBackup.id}`, { method: \"DELETE\", headers: { \"x-organization-id\": orgId }, })"
    ],
    "app/(dashboard)/settings/trash/page.tsx": [
      "params.set(\"entityType\", typeFilter)",
      "params.set(\"search\", search.trim())",
      "fetch(`/api/v1/trash?${params}`, { headers: { \"x-organization-id\": orgId }, })",
      "fetch(`/api/v1/trash/${item.id}/restore`, { method: \"POST\", headers: { \"Content-Type\": \"application/json\", \"x-organization-id\": orgId, }, body: JSON.stringify({ entityType: item.entityType }), })",
      "JSON.stringify({ entityType: item.entityType })",
      "fetch(`/api/v1/trash/${deleteItem.id}`, { method: \"DELETE\", headers: { \"Content-Type\": \"application/json\", \"x-organization-id\": orgId, }, body: JSON.stringify({ entityType: deleteItem.entityType }), })",
      "JSON.stringify({ entityType: deleteItem.entityType })",
      "fetch(\"/api/v1/trash/empty\", { method: \"POST\", headers: { \"x-organization-id\": orgId }, })"
    ],
    "components/bulk-import-wizard.tsx": [
      "fetch(previewEndpoint, { method: \"POST\", headers: { \"Content-Type\": \"application/json\", \"x-organization-id\": orgId }, body: JSON.stringify({ rows: mappedRows, source }), })",
      "JSON.stringify({ rows: mappedRows, source })",
      "fetch(importEndpoint, { method: \"POST\", headers: { \"Content-Type\": \"application/json\", \"x-organization-id\": orgId }, body: JSON.stringify({ fileName, rows: mappedRows, source }), })",
      "JSON.stringify({ fileName, rows: mappedRows, source })",
      "JSON.stringify(p.data)"
    ]
  },
